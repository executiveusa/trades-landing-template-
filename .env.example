# Vercel deployment agent environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Required for the legacy deployment helper only.
VERCEL_TOKEN=your_vercel_token_here

# Preferred selector for this repo until it is linked to a Vercel project.
VERCEL_PROJECT_NAME=trades-landing-template

# Optional. Only set this after Vercel has created/linked the project.
# A valid Vercel Project ID begins with "prj_".
# Example: VERCEL_PROJECT_ID=prj_Rej9WaMNRbffVm34MfDqa4daCEvZzzE
# Do NOT set this to placeholders such as "your_project_id_here".
# VERCEL_PROJECT_ID=

# Optional team context.
# VERCEL_TEAM_ID=team_2MkWeFBaSCv7DOvEy0OlX4s3
