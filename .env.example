# Copy to .env.local. Never commit real values. Secrets belong in the vault, not in this repo.

# Public
# NEXT_PUBLIC_SITE_URL=https://your-domain.example     # enables canonical, sitemap and hreflang URLs
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX                       # optional analytics; events fire only if set

# Lead storage (server only). Without these, leads go to server logs only.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# LEAD_IP_SALT=                                        # any long random string; hashes visitor IPs

# Email notification to Ray (server only, Resend). All three needed.
# RESEND_API_KEY=
# LEAD_NOTIFY_EMAIL=
# LEAD_FROM_EMAIL=
