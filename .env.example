# Vercel Deployment Agent Environment Variables
# Copy this file to .env and fill in your values

# Get VERCEL_TOKEN from: https://vercel.com/account/tokens
# Create a new token with "Full Access"
VERCEL_TOKEN=your_vercel_token_here

# Get VERCEL_PROJECT_ID from Vercel dashboard:
# 1. Go to your project settings
# 2. Copy the Project ID
VERCEL_PROJECT_ID=your_project_id_here

# Your Vercel project name (e.g., "trades-landing-template")
VERCEL_PROJECT_NAME=trades-landing-template

# Optional: Vercel Team ID (if using a team account)
# VERCEL_TEAM_ID=your_team_id_here
